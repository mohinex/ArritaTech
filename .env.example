# Set ONLY in Vercel Project Settings > Environment Variables (Production/Preview as needed).
# Required for contact form, health checks, and inquiry management.
DATABASE_URL=
# Required for /admin; generate using: openssl rand -hex 32
ADMIN_TOKEN=
# Optional. Only set if the PostgreSQL provider requires and supports certificate verification.
PG_SSL=
# Optional: public site address, e.g. https://your-domain.example (for sitemap at build time)
SITE_URL=
