PORT=3001
HOST=127.0.0.1
# Set a long random secret. Required to use the dashboard:
ADMIN_TOKEN=replace-with-a-long-random-secret
# Omit DATABASE_URL to use SQLite offline.
SQLITE_PATH=./data/arrita.sqlite
# Online PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/arrita
# PG_SSL=false
# WEB_ORIGIN=http://localhost:5173
