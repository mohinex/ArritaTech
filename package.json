{
  "name": "arrita-digital-fullstack",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "desktop:dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\" \"npm run dev -w desktop\"",
    "build": "npm run build:vercel",
    "start": "npm run preview -w frontend -- --host 0.0.0.0 --port 3000",
    "desktop:build": "npm run build && electron-builder --config electron-builder.json --dir",
    "test": "node scripts/check-deploy.mjs",
    "build:vercel": "npm run build --workspace @arrita/frontend && node scripts/generate-seo.mjs",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "desktop/main.cjs",
  "dependencies": {
    "pg": "^8.13.1"
  },
  "packageManager": "npm@10.9.2"
}
